# Copy to web/.env.local (gitignored) for local development.
# Vite exposes only VITE_*-prefixed env vars to the client bundle.

# Supabase project URL — for the POC: https://vkvzbcikigubfxwujklv.supabase.green
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe to ship to the client.
# Find at: Dashboard → Settings → API → Project API keys → anon
VITE_SUPABASE_ANON_KEY=

# Ktor api base URL. Defaults to http://localhost:8080 if unset.
# In production (Cloudflare Pages, Phase 0.7) point at the Fly.io
# deployment URL.
VITE_API_URL=http://localhost:8080
