# pg-policy-engine env vars for local development.
#
# Copy to `.env.local` (gitignored) and fill in. The api and worker
# services both read from environment; see api/src/main/kotlin/com/pgpe/api/Main.kt
# and worker/src/main/kotlin/com/pgpe/worker/Main.kt for the keys they
# consume. Docker Compose (Phase 0.5) will load `.env.local` automatically.

# --- Ktor api ---
# Port the api binds to. Default: 8080.
PORT=8080

# --- Worker ---
# Postgres connection string for pgmq polling.
#
# Two options on supabase.com:
#
# 1. Direct connection via db.<ref>.supabase.co (requires the IPv4
#    add-on on the project; the POC has this enabled). Simpler URL,
#    full session-state features.
#
#    Format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
#            ?user=postgres
#            &password=<from ~/.pgpe-supabase-db-password>
#            &sslmode=require
#
# 2. Supavisor pooler (session mode, port 5432). Works without the
#    IPv4 add-on; required for IPv4-only networks if IPv4 is off.
#    Username format: postgres.<project-ref>.
#
#    Format: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#            ?user=postgres.<project-ref>
#            &password=<from ~/.pgpe-supabase-db-password>
#            &sslmode=require
#
# Example for the POC (project ref lqapmmlwmpffbqaqtvtc, us-east-1) via direct:
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?user=postgres&password=YOUR_PASSWORD&sslmode=require

# pgmq queue the worker polls. Default: q_placeholder.
PGMQ_PLACEHOLDER_QUEUE=q_placeholder

# Poll cadence in seconds. Default: 30.
WORKER_POLL_SECONDS=30

# --- Supabase (used by api in later phases, frontend in 0.4) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon key (safe to ship to frontend).
SUPABASE_ANON_KEY=
# Service-role key (server-side only — never expose to frontend).
SUPABASE_SERVICE_ROLE_KEY=
