# pg-policy-engine env vars for local development.
#
# Copy to `.env.local` (gitignored) and fill in. The api and worker
# services both read from environment; see api/src/main/kotlin/com/pgpe/api/Main.kt
# and worker/src/main/kotlin/com/pgpe/worker/Main.kt for the keys they
# consume. Docker Compose (Phase 0.5) will load `.env.local` automatically.

# --- Ktor api ---
# Port the api binds to. Default: 8080.
PORT=8080

# --- Worker ---
# Postgres connection string for pgmq polling.
#
# Use the Supabase pooler (Supavisor / pgbouncer), NOT the direct
# db.<ref>.supabase.<tld> hostname — Supabase projects ship without
# the IPv4 add-on by default and the direct hostname is IPv6-only.
# The pooler always has an IPv4 address. Session mode (port 5432) is
# required for pgmq because pgmq features may use session state that
# transaction mode (6543) doesn't preserve.
#
# Format: jdbc:postgresql://aws-0-<region>.pooler.<supabase-tld>:5432/postgres
#         ?user=postgres.<project-ref>
#         &password=<from ~/.pgpe-supabase-db-password>
#         &sslmode=require
#
# Example for the POC (project ref vkvzbcikigubfxwujklv, region us-east-1,
# host supabase.green):
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.green:5432/postgres?user=postgres.YOUR_PROJECT_REF&password=YOUR_PASSWORD&sslmode=require

# pgmq queue the worker polls. Default: q_placeholder.
PGMQ_PLACEHOLDER_QUEUE=q_placeholder

# Poll cadence in seconds. Default: 30.
WORKER_POLL_SECONDS=30

# --- Supabase (used by api in later phases, frontend in 0.4) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.green
# Anon key (safe to ship to frontend).
SUPABASE_ANON_KEY=
# Service-role key (server-side only — never expose to frontend).
SUPABASE_SERVICE_ROLE_KEY=
